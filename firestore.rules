rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Dokumen profil users/{uid} (kalau ada): admin boleh baca
    match /users/{uid} {
      allow read: if isAdmin();
    }

    // Data tiap user: hanya pemiliknya yang boleh baca/tulis, admin hanya baca
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // Admin membaca lintas user (collection group query) untuk daftar pengguna.
    // Satu blok per subkoleksi di `discover` (js/config.js).
    match /{path=**}/meta/{id}       { allow read: if isAdmin(); }
    match /{path=**}/sales/{id}      { allow read: if isAdmin(); }
    match /{path=**}/expenses/{id}   { allow read: if isAdmin(); }
    match /{path=**}/production/{id} { allow read: if isAdmin(); }

    // Daftar admin: hanya bisa diubah lewat Firebase Console
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
